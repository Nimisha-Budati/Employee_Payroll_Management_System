# Copy this file to ".env" (same folder as manage.py) and fill in real values.
# ".env" is ignored by git. Never commit real secrets.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=employee_payroll
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Only needed when the frontend is served from a non-default origin or in production.
# CORS_ALLOWED_ORIGINS=https://payroll.example.com
# CSRF_TRUSTED_ORIGINS=https://payroll.example.com

# Optional email (password-reset codes print to the console when unset).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Sign in with Google (leave empty to hide/disable the feature) ---------------------------
# Create an OAuth client in Google Cloud Console (see README, section "Google sign-in").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match "Authorized redirect URIs" in Google Cloud Console EXACTLY.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/
# Where the browser is sent after sign-in (your frontend). Production: https://your-domain
FRONTEND_URL=http://127.0.0.1:5500

COMPANY_NAME=PayrollPro
# PAYROLL_WORKING_WEEKDAYS=0,1,2,3,4
# PAYROLL_STANDARD_DAILY_HOURS=8

# --- AI assistance (Google Gemini) -------------------------------------------------------------
# Create a key at https://aistudio.google.com/apikey . Leave empty to switch the AI features off.
GEMINI_API_KEY=
# Pin a model your key lists (run: python manage.py gemini_check), or keep the alias for the latest Flash model.
GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIMEOUT_SECONDS=30
# AI_MAX_REQUESTS_PER_HOUR=40
